# ──────────────────────────────────────────────────────────────────────────────
# mono-backend — environment configuration
# mono-backend
#
# Copy this file to .env and edit values for your local stack.
# Variables declared here override the defaults in configs/{domain}/config.json.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Brand / landing-page name (overrides the default "Rivex" logo mark).
APP_NAME=mono-backend

# Optional admin dashboard. Leave ADMIN_TOKEN empty to expose the dashboard
# without authentication (only safe in local development).
ADMIN_ENABLED=true
ADMIN_URL=/admin
ADMIN_TOKEN=change-me-to-a-long-random-admin-token

# Optional code-generation feature inside the admin dashboard. The
# generator writes new resources (model, repo, services, controller, DTOs,
# etc.) into PROJECT_ROOT. Set PROJECT_ROOT to the directory where the
# generated files should land (defaults to the current working directory).
ADMIN_CODEGEN_ENABLED=true
PROJECT_ROOT=.

DATABASE_URL=postgres://mono-backend:mono-backend_secret@localhost:5432/mono-backend

JWT_SECRET=change-me-to-a-long-random-string-in-production-min-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-min-32-chars
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=info
LOG_FILE=logs/mono-backend.ndjson
LOG_STDOUT=true
LOG_STDOUT_FORMAT=pretty
LOG_STDOUT_COLOR=auto
LOG_CALLER_INFO=true
LOG_SAMPLE_ONE_IN=1

EMAIL_FROM=noreply@mono-backend.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
